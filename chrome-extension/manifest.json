{
  "manifest_version": 3,
  "name": "acaily AI 助手（侧边栏）",
  "version": "1.1.0",
  "description": "浏览器侧边栏 AI 助手：对话、切换模型、语音输入、智能体管理。",
  "permissions": ["sidePanel", "contextMenus", "storage", "tabs"],
  "host_permissions": ["https://acplugin.areteailab.com/*"],
  "action": {
    "default_title": "打开 acaily 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
